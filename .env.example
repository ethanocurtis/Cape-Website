# Port on the Pi that Nginx Proxy Manager forwards to
WEB_PORT=8080
# Time zone and local time for the daily refresh
TZ=America/Chicago
UPDATE_TIME=05:00
# 1 = before each daily refresh, fast-forward to the latest GitHub version
# (cape data is researched and pushed to main every day)
GIT_PULL=1
GIT_BRANCH=main
# Your user/group id on the Pi (run: id -u ; id -g) so the updater writes files as you
PUID=1000
PGID=1000
