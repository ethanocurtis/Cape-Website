# Port on the Pi that Nginx Proxy Manager forwards to
WEB_PORT=8080
# Time zone and local time for the daily refresh
TZ=America/Chicago
UPDATE_TIME=05:00
# 1 = before each daily refresh, fast-forward to the latest GitHub version
# (cape data is researched and pushed to main every day)
GIT_PULL=1
GIT_BRANCH=main
# Your user/group id on the Pi (run: id -u ; id -g) so the updater writes files as you
PUID=1000
PGID=1000
# Public address of the site, used for links in Discord alerts
SITE_URL=https://capes.yourdomain.com
# Email alerts (optional). Use an SMTP relay such as Brevo, Mailgun, Amazon SES,
# or a Gmail/Workspace account with an app password. Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cape Tracker <alerts@yourdomain.com>
