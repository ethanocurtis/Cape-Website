    {
      "id": "aurora",
      "names": {
        "java": "Aurora Cape",
        "bedrock": "Aurora Cape"
      },
      "editions": [
        "java",
        "bedrock"
      ],
      "category": "Limited-time event · Minecraft Dungeons II launch",
      "texture": "7c418dfbd37412a55e9f1425c9807a591ad10cf71b1edb576a587be9114c277f",
      "wiki": "Aurora_Cape",
      "appearance": "A blue-orange-yellow gradient inspired by the sky of the Sift (the new dimension in Minecraft Dungeons II), dotted with small white stars. The elytra version has pointed edges with a pale white-and-green outline.",
      "windows": [
        {
          "role": "earn",
          "label": "Watch-time promotion",
          "start": "2026-09-29T16:00:00Z",
          "end": "2026-10-15T06:59:00Z"
        },
        {
          "role": "redeem",
          "label": "Redeem your code by",
          "end": "2026-10-31",
          "dateOnly": true
        }
      ],
      "steps": [
        "Pick <b>one</b> platform. On <b>Twitch</b>, link your Twitch account and watch any rewards-enabled stream in the <i>Minecraft Dungeons II</i> category for <b>15 minutes</b>. On <b>TikTok</b> (mobile app only), watch any <i>Minecraft Dungeons II</i> live stream with Game Rewards enabled for <b>3 minutes</b>.",
        "Watch time only counts while the stream is live.",
        "Your 5×5 code shows up in your <b>Twitch Drops inventory</b> or in your <b>TikTok notifications</b>.",
        "Redeem the code at <a href=\"https://www.minecraft.net/en-us/redeem\" target=\"_blank\" rel=\"noopener\">minecraft.net/redeem</a> with the Microsoft account you play Minecraft on. The cape unlocks on both Java and Bedrock.",
        "You can redeem one Aurora Cape code per person or Microsoft account. Codes are limited (\"supplies are limited\")."
      ],
      "editionNotes": {
        "java": "Equip it in the Minecraft Launcher (Skins tab) or on your minecraft.net profile. If it doesn't show up on Java, log into Bedrock once with the same account.",
        "bedrock": "Equip it from Dressing Room → Capes in the Character Creator."
      },
      "alerts": [
        "Twitch support reported on Oct 2, 2026 that its Aurora codes are used up. TikTok is the safest way to earn the cape now."
      ],
      "notes": [
        "The Aurora Cape is a Minecraft (Java & Bedrock) cape only. It does not appear in Minecraft Dungeons II itself."
      ],
      "links": [
        {
          "kind": "stream",
          "label": "Twitch – Minecraft Dungeons II streams",
          "url": "https://www.twitch.tv/directory/category/minecraft-dungeons-ii"
        },
        {
          "kind": "stream",
          "label": "TikTok – Minecraft Dungeons II LIVE",
          "url": "https://www.tiktok.com/search/live?q=Minecraft%20Dungeons%20II"
        },
        {
          "kind": "stream",
          "label": "Twitch Drops inventory",
          "url": "https://www.twitch.tv/drops/inventory"
        },
        {
          "kind": "redeem",
          "label": "Redeem code – minecraft.net/redeem",
          "url": "https://www.minecraft.net/en-us/redeem"
        },
        {
          "kind": "info",
          "label": "Official announcement",
          "url": "https://www.minecraft.net/en-us/article/minecraft-dungeons-ii-capes-promos"
        }
      ],
      "sources": [
        "mcnet-mcd2",
