      "appearance": "Red cloth with a golden Redstone Monstrosity face and gold trim along the bottom. The elytra has an embroidered gold pattern in the same colors.",
      "windows": [
        {
          "role": "earn",
          "label": "Log into Dungeons II",
          "start": "2026-09-29",
          "end": "2026-12-31",
          "dateOnly": true,
          "exclusiveEnd": true
        }
      ],
      "steps": [
        "Play the original <b>Minecraft Dungeons</b> on your Microsoft account. You don't need to own the Dungeons Hero Cape.",
        "Then log into <b>Minecraft Dungeons II</b> on the same Microsoft account <b>before December 31, 2026</b>.",
        "When Dungeons II shows the cape as equippable, launch <b>Minecraft: Java and/or Bedrock Edition</b> on that same account to unlock it there.",
        "Use the same Microsoft account in every game, even when you play couch co-op."
      ],
      "editionNotes": {
        "java": "Equip it in the Minecraft Launcher (Skins tab) or on your minecraft.net profile.",
        "bedrock": "Equip it from Dressing Room → Capes."
      },
      "alerts": [
        "Refunding Minecraft Dungeons II removes this cape from your account."
      ],
